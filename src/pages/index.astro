---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Writing — Vist" description="Writing archive by Vist.">
  <main class="shell archive-page">
    <header class="archive-head">
      <h1 class="archive-title">Writing</h1>
    </header>
    <ol class="post-list">
      {posts.map((post, index) => (
        <li class="post-row">
          <span class="post-no mono">{String(index + 1).padStart(2, "0")}</span>
          <a class="post-row-title" href={`${base}${post.slug}/`}>{post.data.title}</a>
          <time class="post-date mono" datetime={post.data.date.toISOString()}>
            {post.data.date.toISOString().slice(0, 10)}
          </time>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>
